{
  "name": "helpme-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test tests/browser.spec.ts --workers=1 --reporter=list",
    "appwrite:setup": "node --env-file=.env.local --import tsx scripts/setup-appwrite.ts",
    "test:appwrite": "node --env-file=.env.local --import tsx --test tests/appwrite.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "decimal.js": "latest",
    "jose": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "node-appwrite": "^29.2.0",
    "papaparse": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "latest",
    "@types/papaparse": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "otplib": "^13.5.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
